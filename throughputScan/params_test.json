  "testName": {
    "val": "throughputScan",
    "label": "Test Name"
  },
  "testPrefix": {
    "val": "throughputScan",
    "label": "Prefix for CSV filenames"
  },
  "testDescription": {
    "val": "Run throughput tests for different protocols, bandwidths, and packet sizes.  Possibly a very long test, it runs traffic for, say, 11n at 2.4 GHz in 20 MHz, uplink.  Based on the calculable PHY rate, it runs the traffic at different offered loads, e.g. 25%, 50%, 75%, and 100% of that PHY rate.  The traffic is run using, say, 128 byte packets.  It can then do the same test for, say, 256 byte packets.  And for downlink.  And for 20 MHz. Etc.  So for (say) 3 different 802.11 standards, 2 bands, 4 bandwidths, up/down, 4 loads, and 4 packet sizes, this would have to run 768 separate tests.",
    "label": "Test Description"
  },
