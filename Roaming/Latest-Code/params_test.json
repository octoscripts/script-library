  "testName": {
    "val": "Roaming",
    "label": "Test Name"
  },
  "testPrefix": {
    "val": "roaming",
    "label": "Prefix for CSV filenames"
  },
  "testDescription": {
    "val": "Roam from box A to box B, and capture sniffing trace.  Test finds the attenuation value at which the connection to box A breaks, and the same for box B.  It then tries to create an attenuation ramping range to focus on the condition to cause a roam.  The roam is caused, the data is sniffed, the roam time is calculated.  Then the test allows the user to ask for this to be done over and over again.  Statistics are stored in the results log file.",
    "label": "Test Description"
  },
