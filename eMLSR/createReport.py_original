                                returnedReportItems = returnedReport["Report"]
                                for item in returnedReportItems:
                                        if "type" in item:

                                                if item["title"]=="Packets from AP" and item["type"]=="pie" and plots[0]==None:
                                                        plots[0] = json.loads(json.dumps(item))
                                                elif item["title"]=="Packets from AP" and item["type"]=="pie" and plots[0]!=None:
