                                myReport["Report"].append(item);
                                myReport["Report"].append(plot);
                                item = {'elementType':'gridFormatting','action':'endItem'}
                                myReport["Report"].append(item);
                        item = {'elementType':'gridFormatting','action':'end'}
                        myReport["Report"].append(item);

